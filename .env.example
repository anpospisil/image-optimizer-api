# Copy to .env and fill in values. Never commit .env to git.

# Path to your sticker image for content moderation
# Leave blank to fall back to Gaussian blur
STICKER_PATH=assets/sticker.png

# Optional: path to a .ttf font for watermarks
# Leave blank to use PIL's built-in default font
FONT_PATH=

# Watermark defaults (can be overridden per-request via the config payload)
DEFAULT_WATERMARK_OPACITY=180
DEFAULT_WATERMARK_PADDING=20

# Content moderation defaults
DEFAULT_BLUR_INTENSITY=25
DEFAULT_DETECTION_THRESHOLD=0.01

# CORS — comma-separated list of allowed frontend origins
# In production, set this to your exact Vercel URL
ALLOWED_ORIGINS=http://localhost:3000

